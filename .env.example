# Gemini API key for Google ADK (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Arcade API key (https://arcade.dev) — enable Google Drive, Google Search, and Firecrawl
ARCADE_API_KEY=

# End-user id for Arcade OAuth and tool calls
ARCADE_USER_ID=

# Local workspace directory (default: workspace)
# JOB_HUNTER_WORKSPACE=workspace

# Optional Gemini model override
# JOB_HUNTER_MODEL=
